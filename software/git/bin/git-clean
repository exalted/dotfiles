#!/usr/bin/env bash

# A folder needs two entries: "name/" for the folder itself and "**/name/**"
# for files inside it that the repository ignores one by one.
keep=(
    CLAUDE.local.md
    .claude/
    '**/.claude/**'
)

for pattern in "${keep[@]}"; do
    case $pattern in
        '' | '!'* | '#'*)
            echo "git-clean: keep patterns can't be empty or start with ! or #: '$pattern'" >&2
            exit 1
            ;;
    esac
done

# Is this an `-X` (remove only ignored files) run? Parsed properly rather than
# grepped: in `-eX` the X is an exclude pattern, and mistaking it for -X would
# un-ignore the keep list below and let a plain clean delete it.
only_ignored() {
    local flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --) return 1 ;;
            --exclude) shift ;;
            --*) ;;
            -*)
                # -e takes the rest of its cluster as the pattern, or the next
                # argument when nothing follows it.
                flags="${1%%e*}"
                [[ "$flags" == *X* ]] && return 0
                [ "$1" = "${flags}e" ] && shift
                ;;
        esac
        shift
    done
    return 1
}

# Under -X an ignore rule would get the file removed, so un-ignore it instead.
negate=
only_ignored "$@" && negate='!'

excludes=()
for pattern in "${keep[@]}"; do
    excludes+=(-e "$negate$pattern")
done

git clean "${excludes[@]}" "$@"
