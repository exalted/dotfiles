#!/usr/bin/env bash

# Is this an `-X` (remove only ignored files) run? Parsed properly rather than
# grepped: in `-eX` the X is an exclude pattern, and mistaking it for -X would
# un-ignore .claude/ below and let a plain clean delete it.
only_ignored() {
    local flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --) return 1 ;;
            --exclude) shift ;;
            --*) ;;
            -*)
                # -e takes the rest of its cluster as the pattern, or the next
                # argument when nothing follows it.
                flags="${1%%e*}"
                [[ "$flags" == *X* ]] && return 0
                [ "$1" = "${flags}e" ] && shift
                ;;
        esac
        shift
    done
    return 1
}

args=()

# Make sure to not remove local Claude Code settings and memories erroneously.
# An --exclude pattern is an ignore rule, so it protects .claude/ only while
# ignored files are spared. -X deletes exactly the ignored files, so there the
# patterns have to un-ignore .claude/ instead — the directory itself too, as git
# never looks inside an ignored directory for files to re-include.
if [ -d ".claude/" ]; then
    claude="/$(git rev-parse --show-prefix).claude/"
    if only_ignored "$@"; then
        args+=("--exclude=!${claude}" "--exclude=!${claude}**")
    else
        args+=("--exclude=${claude}")
    fi
fi

git clean "${args[@]}" "$@"
