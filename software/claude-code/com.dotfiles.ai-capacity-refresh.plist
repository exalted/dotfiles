<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dotfiles.ai-capacity-refresh</string>
	<!-- The script is the executable on purpose: macOS names a background item after
	     its executable in the Login Items notice and settings.
	     launchd expands no variables, so the installer renders @HOME@ when copying. -->
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.claude/ai-capacity-refresh.sh</string>
	</array>
	<!-- Weekly, in the slot work-hours-gate.sh allows (Wednesday 17:00, after Claude's 7-day window reset,
	     to Sunday 22:00): each trigger retries until one run succeeds. A trigger slept through fires on
	     wake, and the gate skips it in work hours. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>3</integer>
			<key>Hour</key>
			<integer>17</integer>
			<key>Minute</key>
			<integer>23</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>17</integer>
			<key>Minute</key>
			<integer>23</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>6</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>23</integer>
		</dict>
	</array>
</dict>
</plist>
