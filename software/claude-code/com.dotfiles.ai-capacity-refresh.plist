<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dotfiles.ai-capacity-refresh</string>
	<!-- The script is the executable on purpose: macOS names a background item after
	     its executable in the Login Items notice and settings.
	     launchd expands no variables, so the installer renders @HOME@ when copying. -->
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.claude/ai-capacity-refresh.sh</string>
	</array>
	<!-- Weekly, Wednesday 06:23 local: just after Claude's 7-day window resets, so the
	     week just ended is complete. A time slept through runs on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>3</integer>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>23</integer>
	</dict>
</dict>
</plist>
