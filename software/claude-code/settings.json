{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VISUAL": "zed-preview --new"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(rm *)",
      "Bash(/bin/rm *)",
      "Bash(\\rm *)",
      "Bash(rmdir *)",
      "Bash(/bin/rmdir *)",
      "Bash(unlink *)",
      "Bash(/bin/unlink *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec* rm *)",
      "Bash(find * -exec* /bin/rm *)",
      "Bash(xargs * rm *)",
      "Bash(xargs * /bin/rm *)",
      "Bash(git clean *)",
      "Bash(shred *)"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "cowork-plugin-management:create-cowork-plugin": "off"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-command-prefix.py refresh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-command-prefix.py check",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "obsidian-notes@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "custom:dark-mine",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754577304660
  }
}
