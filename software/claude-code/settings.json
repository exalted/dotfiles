{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VISUAL": "zed-preview --new"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(rm *)",
      "Bash(/bin/rm *)",
      "Bash(\\rm *)",
      "Bash(rmdir *)",
      "Bash(/bin/rmdir *)",
      "Bash(unlink *)",
      "Bash(/bin/unlink *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec* rm *)",
      "Bash(find * -exec* /bin/rm *)",
      "Bash(xargs * rm *)",
      "Bash(xargs * /bin/rm *)",
      "Bash(git clean *)",
      "Bash(shred *)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git rebase *)",
      "Bash(git reset *--hard*)",
      "Bash(git commit *--amend*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * reset *--hard*)",
      "Bash(git -C * commit *--amend*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "cowork-plugin-management:create-cowork-plugin": "off"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-command-prefix.py refresh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-command-prefix.py check",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-paths.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-deletions.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "obsidian-notes@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "custom:dark-mine",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754577304660
  },
  "plansDirectory": ".claude/plans",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Datadog"
    },
    {
      "serverName": "claude.ai Datadog (2)"
    },
    {
      "serverUrl": "https://mcp.datadoghq.eu/api/unstable/*"
    }
  ]
}
