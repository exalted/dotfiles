<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dotfiles.claude-code-levers-refresh</string>
	<!-- The script is the executable on purpose: macOS names a background item after
	     its executable in the Login Items notice and settings, and /bin/sh showed up as "sh".
	     launchd expands no variables, so the installer renders @HOME@ when copying. -->
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.claude/claude-code-levers-refresh.sh</string>
	</array>
	<!-- Weekly, in the slot work-hours-gate.sh allows (Friday 17:00 to Sunday 22:00): each trigger retries
	     until one run succeeds. A trigger slept through fires on wake, and the gate skips it in work hours.
	     Off the hour so it does not pile onto the API with every other scheduled job. Change the schedule and
	     skills/common/claude-code-levers/freshness.json together: its margin covers this retry slot. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>5</integer>
			<key>Hour</key>
			<integer>17</integer>
			<key>Minute</key>
			<integer>17</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>6</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>17</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>0</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>17</integer>
		</dict>
	</array>
</dict>
</plist>
